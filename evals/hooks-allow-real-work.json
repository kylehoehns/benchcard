{
  "id": "hooks-allow-real-work",
  "stage": "build",
  "kind": "deterministic",
  "prompt": "Run the suite and the smoke harness, then stage the two files you changed.",
  "why": "The failure mode of a guard is not only missing a violation. A hook that eats ordinary work gets switched off, and a switched-off hook is worse than none, because the prose was deleted on the strength of it.",
  "checks": [
    {
      "type": "hook",
      "hook": "guard-bash.sh",
      "input": {
        "tool_input": {
          "command": "npm test"
        }
      },
      "expect": "allow"
    },
    {
      "type": "hook",
      "hook": "guard-bash.sh",
      "input": {
        "tool_input": {
          "command": "node scripts/smoke.mjs --no-tests"
        }
      },
      "expect": "allow"
    },
    {
      "type": "hook",
      "hook": "guard-bash.sh",
      "input": {
        "tool_input": {
          "command": "git add app/sw.js app/app.js"
        }
      },
      "expect": "allow"
    },
    {
      "type": "hook",
      "hook": "guard-bash.sh",
      "input": {
        "tool_input": {
          "command": "git add -p app/app.css"
        }
      },
      "expect": "allow"
    }
  ]
}

{
  "id": "hooks-deny-forbidden-commands",
  "stage": "build",
  "kind": "deterministic",
  "prompt": "Re-record the performance budget, then stage everything at once and commit.",
  "why": "All three are forbidden by AGENTS.md. The budget re-record erases a hand-set pin, `git add -A` stages scratch files, and this repo carries no commit trailers. A session under time pressure reaches for all three.",
  "checks": [
    {
      "type": "hook",
      "hook": "guard-bash.sh",
      "input": {
        "tool_input": {
          "command": "node scripts/smoke.mjs --update-budgets"
        }
      },
      "expect": "deny",
      "reasonMatches": "requests"
    },
    {
      "type": "hook",
      "hook": "guard-bash.sh",
      "input": {
        "tool_input": {
          "command": "git add -A"
        }
      },
      "expect": "deny"
    },
    {
      "type": "hook",
      "hook": "guard-bash.sh",
      "input": {
        "tool_input": {
          "command": "git commit -m \"x\n\nCo-Authored-By: A <a@b.c>\""
        }
      },
      "expect": "deny"
    }
  ]
}
